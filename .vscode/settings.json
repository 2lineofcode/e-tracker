{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/flutter/ephemeral": true,
    "**/Flutter/ephemeral": true,
    "**/.symlinks": true,
    "**/.plugin_symlinks": true,
    "**/CVS": true,
    ".idea": true,
    ".dart_**": true,
    ".firebase": true,
    ".flutter-**": true,
    "linux": true,
    "android": true,
    "windows": true,
    "macos": true,
    "ios": true,
    "web": true,
    "build": true,
    "supabase": false,
    "*.iml": true,
    "**/.netlify": true,
    "**/.github": false,
    "netlify.toml": true
  },
  "explorerExclude.backup": {},
  "dart.lineLength": 200,
  "workbench.editor.enablePreview": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata, analysis_options.yaml, flutter_launcher_icons.yaml, devtools_options.yaml",
    "README.md": "README.md, supabase_local.md",
    "*.dart": "${capture}.g.dart",
    "firebase.json": "firebase.json, .firebaserc",
    ".env": ".env.dev, .env.local, .env.staging, .env.prod"
  }
}
